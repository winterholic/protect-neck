/* 전체 배경 */
QWidget {
    background-color: #F5F1E8;
    font-family: '맑은 고딕', 'Malgun Gothic', sans-serif;
    color: #3D3D3D;
}

/* 메인 탭 */
QTabWidget::pane {
    border: none;
    background-color: #F5F1E8;
}

QTabBar::tab {
    background-color: #E8DCC4;
    color: #3D3D3D;
    padding: 12px 24px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #F5F1E8;
    font-weight: bold;
}

/* 타이머 디스플레이 */
#timerDisplay {
    font-size: 120px;
    font-family: 'Consolas', 'Courier New', monospace;
    color: #5A5A5A;
    font-weight: 300;
}

/* 일시정지/재생 버튼 */
#playPauseButton {
    background-color: #A8C5A0;
    color: white;
    font-size: 18px;
    font-weight: bold;
    padding: 15px 40px;
    border: none;
    border-radius: 30px;
    min-width: 200px;
    min-height: 60px;
}

#playPauseButton:hover {
    background-color: #96B38E;
}

#playPauseButton:pressed {
    background-color: #89A582;
}

/* 선택 화면 메시지 */
#choiceMessage {
    font-size: 32px;
    font-weight: bold;
    color: #3D3D3D;
    margin-bottom: 20px;
}

/* 스킵 버튼 */
#skipButton {
    background-color: #E0E0E0;
    color: #5A5A5A;
    font-size: 16px;
    padding: 12px 30px;
    border: none;
    border-radius: 20px;
    min-width: 250px;
    min-height: 50px;
}

#skipButton:hover {
    background-color: #D0D0D0;
}

/* 스트레칭 버튼 */
#stretchButton {
    background-color: #A8C5A0;
    color: white;
    font-size: 18px;
    font-weight: bold;
    padding: 15px 30px;
    border: none;
    border-radius: 20px;
    min-width: 250px;
    min-height: 50px;
}

#stretchButton:hover {
    background-color: #96B38E;
}

/* 화장실/산책 버튼 */
#breakButton {
    background-color: #9DB4C0;
    color: white;
    font-size: 16px;
    font-weight: bold;
    padding: 12px 30px;
    border: none;
    border-radius: 20px;
    min-width: 250px;
    min-height: 50px;
}

#breakButton:hover {
    background-color: #8BA3AF;
}

/* 복귀 버튼 */
#returnButton {
    background-color: #A8C5A0;
    color: white;
    font-size: 16px;
    font-weight: bold;
    padding: 12px 30px;
    border: none;
    border-radius: 20px;
    min-width: 180px;
    min-height: 50px;
}

#returnButton:hover {
    background-color: #96B38E;
}

/* 경과 시간 타이머 */
#elapsedTimer {
    font-size: 40px;
    font-family: 'Consolas', 'Courier New', monospace;
    color: #7A7A7A;
    font-weight: 300;
}

/* 스트레칭 이미지 */
#stretchImage, #breakImage {
    border-radius: 16px;
    background-color: white;
    padding: 10px;
}

/* 스트레칭 타이머 */
#stretchTimer {
    font-size: 40px;
    font-family: 'Consolas', 'Courier New', monospace;
    color: #7A7A7A;
    font-weight: 300;
}

/* 스트레칭 자막 */
#stretchMessage {
    font-size: 28px;
    color: #3D3D3D;
    padding: 0 40px;
    line-height: 1.4;
}
